# "anthropic-workspace-id is required..." otherwise)
ANTHROPIC_WORKSPACE_ID=

# Auth — used to sign teacher login session tokens (JWTs).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
